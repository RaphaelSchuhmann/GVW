		lbat_cpu_limit = <0xdbba0 0xdbba0 0x13d620>;
		oc_cpu_limit = <0xdbba0 0xdbba0 0x13d620>;
		phandle = <0x1b1>;
	};

	md_power_throttling {
		compatible = "mediatek,md-power-throttling";
		lbat_md_reduce_tx = <0x06>;
		oc_md_reduce_tx = <0x06>;
		phandle = <0x1b2>;
	};

	bp_thl {
		compatible = "mediatek,mtk-bp-thl";
		soc_limit = <0x0f>;
		soc_limit_ext = <0x14>;
		soc_limit_ext_release = <0x19>;
		phandle = <0x1b3>;
	};

	swpm {
		compatible = "mediatek,mtk-swpm";
		pmu-boundary-num = <0x00>;
		pmu-dsu-support = <0x00>;
		pmu-dsu-type = <0x09>;
		phandle = <0x1b4>;
	};

	mtk_lpm {
		compatible = "mediatek,mtk-lpm";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		lpm-kernel-suspend = <0x00>;
		suspend-method = "enable";
		logger-enable-states = "mcusysoff", "system_mem", "system_pll", "system_bus";
		irq-remain = <0xaf 0xb0 0xb1 0xb2>;
		resource-ctrl = <0xb3 0xb4 0xb5 0xb6 0xb7>;
		constraints = <0xb8 0xb9 0xba 0xbb>;
		spm-cond = <0xbc 0xbd>;
		cg-shift = <0x00>;
		pll-shift = <0x10>;
		power-gs = <0x00>;
		mcusys-cnt-chk = <0x01>;
		phandle = <0x1b5>;

		cpupm-sysram@11b000 {
			compatible = "mediatek,cpupm-sysram";
			reg = <0x00 0x11b000 0x00 0x500>;
			phandle = <0x1b6>;
		};

		lpm_sysram@11b500 {
			compatible = "mediatek,lpm-sysram";
			reg = <0x00 0x11b500 0x00 0x300>;
			phandle = <0x1b7>;
		};

		mcusys-ctrl@c53a000 {
			compatible = "mediatek,mcusys-ctrl";
			reg = <0x00 0xc53a000 0x00 0x1000>;
			phandle = <0x1b8>;
		};

		irq-remain-list {

			edge_keypad {
				target = <0xbe>;
				value = <0x01 0x00 0x00 0x04>;
				phandle = <0xaf>;
			};

			level_btif_tx {
				target = <0xbf>;
				value = <0x00 0x01 0x00 0x00>;
				phandle = <0xb0>;
			};

			level_btif_rx {
				target = <0xbf>;
				value = <0x00 0x02 0x00 0x00>;
				phandle = <0xb1>;
			};

			level_usb_host {
				target = <0xc0>;
				value = <0x00 0x00 0x00 0x00>;
				phandle = <0xb2>;
			};
		};

		resource-ctrl-list {

			bus26m {
				id = <0x00>;
				value = <0x00>;
				phandle = <0xb3>;
			};

			infra {
				id = <0x01>;
				value = <0x00>;
				phandle = <0xb4>;
			};

			syspll {
				id = <0x02>;
				value = <0x00>;
				phandle = <0xb5>;
			};

			dram_s0 {
				id = <0x03>;
				value = <0x00>;
				phandle = <0xb6>;
			};

			dram_s1 {
				id = <0x04>;
				value = <0x00>;
				phandle = <0xb7>;
			};
		};

		constraint-list {

			rc_bus26m {
				rc-name = "bus26m";
				id = <0x00>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0xb8>;
			};

			rc_syspll {
				rc-name = "syspll";
				id = <0x01>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0xb9>;
			};

			rc_dram {
				rc-name = "dram";
				id = <0x02>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0xba>;
			};

			rc_cpu_buck_ldo {
				rc-name = "cpu-buck-ldo";
				id = <0x03>;
				value = <0x01>;
				cond-info = <0x00>;
				phandle = <0xbb>;
			};
		};

		spm-cond-list {

			spm_cond_cg {
				cg-name = "MTCMOS_0", "MTCMOS_1", "INFRA_0", "INFRA_1", "PERI_0", "PERI_1", "MMSYS_0", "MMSYS_1", "MDPSYS_0";
				phandle = <0xbc>;
			};

			spm_cond_pll {
				pll-name = "TVDPLL", "UNIVPLL", "MSDCPLL", "IMGPLL", "MFGPLL", "APLL1", "APLL2";
				phandle = <0xbd>;
			};
		};

		power-gs-list {
		};
	};

	clock_buffer_ctrl {
		compatible = "mediatek,clock_buffer_ctrl";
		mediatek,xo-buf-hwbblpm-mask = <0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		mediatek,xo-buf-hwbblpm-bypass = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		mediatek,xo-bbck4 = <0x00>;
		mediatek,enable;
		pmif = <0xc1 0x00>;
		pmif_version = <0x02>;
		srclken_rc = <0xc2>;
		phandle = <0x2f>;
	};

	speech-usip-mem {
		compatible = "mediatek,speech-usip-mem";
		adsp-phone-call-enh-enable = <0x05>;
		phandle = <0x1b9>;
	};

	met {

		met-emi {
			compatible = "mediatek,met_emi";
			emi-num = <0x01>;
			dram-num = <0x02>;
			dramc-ver = <0x02>;
			met-emi-support-list = <0x01>;
			cen-emi-reg-base = <0x10219000 0x1021d000>;
			cen-emi-reg-size = <0x1000>;
			chn-emi-reg-base = <0x10235000 0x10245000 0x10255000 0x10265000>;
			chn-emi-reg-size = <0xa90>;
			dramc-nao-reg-base = <0x10234000 0x10244000 0x10254000 0x10264000>;
			dramc-nao-reg-size = <0xb6c>;
			dramc-ao-reg-base = <0x10230000 0x10240000 0x10250000 0x10260000>;
			dramc-ao-reg-size = <0x2000>;
			ddrphy-ao-reg-base = <0x10238000 0x10248000 0x10258000 0x10268000>;
			ddrphy-ao-reg-size = <0x1650>;
			ddrphy-ao-misc-cg-ctrl0 = <0x4ec>;
			ddrphy-ao-misc-cg-ctrl2 = <0x4f4>;
			dram-freq-default = <0x1900>;
			ddr-ratio-default = <0x08>;
			dram-type-default = <0x08>;
			apmixedsys-reg-base = <0x1000c000>;
			apmixedsys-reg-size = <0x410>;
			slc-pmu-reg-base = <0x10342000 0x10343000>;
			slc-pmu-reg-size = <0x1000>;
