	gpu-qos {
		compatible = "mediatek,gpu_qos";
		qos-sysram-support = <0x00>;
		qos-mode = <0x00>;
		qos-value = <0x00>;
		phandle = <0x1bd>;
	};

	trusty {
		compatible = "android,trusty-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x00>;
		tee-name = "trusty";
		phandle = <0x1be>;

		trusty-virtio {
			compatible = "android,trusty-virtio-v1";
			phandle = <0xc3>;
		};

		trusty-irq {
			compatible = "android,trusty-irq-v1";
			ppi-interrupt-parent = <0x01>;
			phandle = <0xc4>;
		};

		tz-system {
			compatible = "mediatek,trusty-tz";
			virtio-supply = <0xc3>;
			irq-supply = <0xc4>;
			phandle = <0xc5>;
		};

		mtee {
			compatible = "mediatek,trusty-mtee-v1";
			tz-supply = <0xc5>;
		};

		trusty-gz-log {
			compatible = "android,trusty-gz-log-v1";
		};
	};

	nebula {
		compatible = "android,nebula-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x01>;
		tee-name = "nebula";

		nebula-virtio {
			compatible = "android,nebula-virtio-v1";
		};

		nebula-irq {
			compatible = "android,nebula-irq-v1";
			ppi-interrupt-parent = <0x01>;
		};

		nebula-gz-log {
			compatible = "android,nebula-gz-log-v1";
		};
	};

	__symbols__ {
		chosen = "/chosen";
		board_id = "/board_id";
		product_region = "/product_region";
		cpu0 = "/cpus/cpu@0";
		cpu1 = "/cpus/cpu@1";
		cpu2 = "/cpus/cpu@2";
		cpu3 = "/cpus/cpu@3";
		cpu4 = "/cpus/cpu@4";
		cpu5 = "/cpus/cpu@5";
		cpu6 = "/cpus/cpu@100";
		cpu7 = "/cpus/cpu@101";
		cpuoff_l = "/cpus/idle-states/cpuoff_l";
		cpuoff_b = "/cpus/idle-states/cpuoff_b";
		clusteroff_l = "/cpus/idle-states/clusteroff_l";
		clusteroff_b = "/cpus/idle-states/clusteroff_b";
		mcusysoff = "/cpus/idle-states/mcusysoff";
		system_mem = "/cpus/idle-states/system_mem";
		system_pll = "/cpus/idle-states/system_pll";
		system_bus = "/cpus/idle-states/system_bus";
		s2idle = "/cpus/idle-states/s2idle";
		gic = "/interrupt-controller";
		cpuhvfs = "/cpuhvfs@114400";
		tboard_thermistor1 = "/thermal-ntc1";
		tboard_thermistor2 = "/thermal-ntc2";
		tboard_thermistor3 = "/thermal-ntc3";
